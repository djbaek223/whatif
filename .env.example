# AI narration provider: deepseek (default) or openai. Without the provider's key the game runs with template text.
WHATIF_PROVIDER=
# Optional: model override (default deepseek-flash for deepseek, gpt-6-luna for openai)
WHATIF_MODEL=

# DeepSeek. For BytePlus ModelArk set DEEPSEEK_BASE_URL=https://ark.ap-southeast.bytepluses.com/api/v3
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=

# OpenAI (GPT-6 Luna)
OPENAI_API_KEY=
# Optional: OpenAI-compatible base URL (default https://api.openai.com/v1) and reasoning effort (e.g. low)
OPENAI_BASE_URL=
OPENAI_REASONING_EFFORT=

# 의견 보내기: Resend API key (https://resend.com). Without it the form points players to their mail app.
RESEND_API_KEY=
# Optional: recipient (default dj.baek223@gmail.com) and sender (default WhatIf <onboarding@resend.dev>, which only delivers to the Resend account's own address)
FEEDBACK_TO=
FEEDBACK_FROM=
