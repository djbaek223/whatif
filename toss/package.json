{
  "name": "whatif-toss",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "What If as an 앱인토스 (Apps in Toss) non-game WebView mini-app. Builds the same game as the website (../src) into a static bundle.",
  "scripts": {
    "dev": "vite --host",
    "build": "vite build && ait build",
    "build:web": "vite build",
    "preview": "vite preview --host",
    "typecheck": "tsc --noEmit",
    "deploy": "ait deploy"
  },
  "dependencies": {
    "@apps-in-toss/web-framework": "3.10.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4",
    "@types/node": "^20.19.43",
    "@vitejs/plugin-react": "^5",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vite": "^7"
  }
}
