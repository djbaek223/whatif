# Where the game's API lives (AI narration, memoir board, feedback). The website serves it.
WHATIF_API_BASE=https://whatif.host

# Toss ad group ids from the 앱인토스 console (광고 > 광고 그룹). The release ids are in .env.production;
# set these only to override them (e.g. empty for no ads in vite dev).
# Never ship test ad group ids in a release bundle: review rejects them.
VITE_TOSS_AD_BANNER=
VITE_TOSS_AD_FULLSCREEN=

# 1 shows a keyboard/scroll log at the top of the screen, for device tests only. Never in a release bundle.
VITE_KB_DEBUG=
