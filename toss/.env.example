# Where the game's API lives (AI narration, memoir board, feedback). The website serves it.
WHATIF_API_BASE=https://whatif.host

# Toss ad group ids from the 앱인토스 console (광고 > 광고 그룹). Leave empty for no ads.
# Never ship test ad group ids in a release bundle: review rejects them.
VITE_TOSS_AD_BANNER=
VITE_TOSS_AD_FULLSCREEN=
